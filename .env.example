# ─── Mock Mode (Recommended for local dev) ────────────────────────────────────
# Set this to true to run the pipeline with deterministic mock outputs.
# No API key is required when this is true.
MOCK_LLM=true

# ─── Real Provider Mode ───────────────────────────────────────────────────────
# If MOCK_LLM is false or omitted, the pipeline will hit OpenAI.
# An API key is REQUIRED in this mode.
OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM Model (Optional, defaults to gpt-4o)
SPECFORGE_MODEL=gpt-4o
